generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  commandedUnits Unit[]   @relation("UnitCommander")
  memberships    AuthorizedUserMembership[] @relation("MembershipUser")
  createdMemberships AuthorizedUserMembership[] @relation("MembershipCreator")
  createdGrants PermissionGrant[] @relation("GrantCreator")
  revokedGrants PermissionGrant[] @relation("GrantRevoker")
  ownedEvents Event[] @relation("EventOwner")
  eventAuthorizations EventAuthorizedUser[] @relation("EventAuthorizedUser")
  addedEventAuthorizations EventAuthorizedUser[] @relation("EventAuthorizationCreator")
  auditDrafts Audit[] @relation("AuditCreator")
  proposedEventResults EventResult[] @relation("EventResultProposer")
  reviewedEventResults EventResult[] @relation("EventResultReviewer")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Event {
  id          String                @id @default(cuid())
  name        String
  scheduledAt DateTime
  eventType   String
  description String?
  opponent    String?
  map         String?
  defenderFlagRef String?
  attackerFlagRef String?
  ownerUserId String
  owner       User                  @relation("EventOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  participations EventParticipation[]
  authorizedUsers EventAuthorizedUser[]
  commandGroups EventCommandGroup[]
  resultRecords EventResult[]

  @@index([ownerUserId])
}

model EventAuthorizedUser {
  id            String   @id @default(cuid())
  eventId       String
  userId        String
  addedByUserId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user          User     @relation("EventAuthorizedUser", fields: [userId], references: [id], onDelete: Restrict)
  addedBy       User     @relation("EventAuthorizationCreator", fields: [addedByUserId], references: [id], onDelete: Restrict)

  @@unique([eventId, userId])
  @@index([userId])
  @@index([addedByUserId])
}

enum EventParticipationStatus {
  REQUESTED
  APPROVED
  DENIED
}

model EventParticipation {
  id        String                     @id @default(cuid())
  eventId   String
  event     Event                      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  unitId    String
  unit      Unit                       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  status    EventParticipationStatus   @default(REQUESTED)
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt
  atomicUnits AtomicEventUnit[]
  commandGroups EventCommandGroup[]

  @@unique([eventId, unitId])
  @@index([eventId])
  @@index([unitId])
  @@index([status])
}

enum BattlefieldSide {
  ATTACKER
  DEFENDER
}

enum EventResultValue {
  ATTACKER_WIN
  DEFENDER_WIN
  DRAW
}

enum EventResultStatus {
  EFFECTIVE
  PENDING
  SUPERSEDED
  REJECTED
}

model AtomicEventUnit {
  id                   String             @id @default(cuid())
  eventParticipationId String
  name                 String?
  side                 BattlefieldSide?
  auditUnitType        AuditUnitType?
  isMandatory          Boolean
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  eventParticipation   EventParticipation @relation(fields: [eventParticipationId], references: [id], onDelete: Restrict)
  audit                Audit?
  commandGroupMembership EventCommandGroupAtomicUnit?

  @@index([eventParticipationId, createdAt])
}

model Unit {
  id              String    @id @default(cuid())
  name            String
    description     String?
    imageRef        String?
    discordInvite   String?
    groupLink       String?
  parentId        String?
  parent          Unit?     @relation("UnitHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        Unit[]    @relation("UnitHierarchy")
  rootUnitId      String?
  rootUnit        RootUnit? @relation("UnitRoot", fields: [rootUnitId], references: [unitId], onDelete: Restrict)
  rootDesignation RootUnit? @relation("RootDesignation")
  commanderUserId String
  commander       User      @relation("UnitCommander", fields: [commanderUserId], references: [id], onDelete: Restrict)
  memberships     AuthorizedUserMembership[]
  eventParticipations EventParticipation[]
  playerMemberships UnitMembership[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([rootUnitId])
  @@index([commanderUserId])
}

model Player {
  id          String           @id @default(cuid())
  playerId    String           @unique
  name        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  memberships UnitMembership[]
  auditResults AuditPlayerResult[]
  auditRoles AuditRoleAssignment[]
  commandedEventGroups EventCommandGroup[] @relation("EventGroupCommander")
}

enum AuditLifecycle {
  DRAFT
  FINAL
}

enum AuditUnitType {
  REGULAR
  RIFLES
  CAVALRY
  ARTILLERY
}

enum AuditRoleAssignmentRole {
  COMMANDER
  FLAG_BEARER
}

model Audit {
  id                  String             @id @default(cuid())
  atomicEventUnitId   String             @unique
  createdByUserId     String
  lifecycle           AuditLifecycle     @default(DRAFT)
  rawData             String?
  unitType            AuditUnitType?
  tickets             Int?
  flagCaptures        Int?
  flagLosses          Int?
  stars               Int?
  submittedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  atomicEventUnit     AtomicEventUnit    @relation(fields: [atomicEventUnitId], references: [id], onDelete: Restrict)
  creator             User               @relation("AuditCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  playerResults       AuditPlayerResult[]
  roles               AuditRoleAssignment[]

  @@index([createdByUserId])
  @@index([lifecycle])
}

model AuditPlayerResult {
  id        String   @id @default(cuid())
  auditId   String
  playerId  String
  kills     Int
  deaths    Int
  assists   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  audit     Audit    @relation(fields: [auditId], references: [id], onDelete: Restrict)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([auditId, playerId])
  @@index([auditId])
  @@index([playerId])
}

model AuditRoleAssignment {
  id        String                  @id @default(cuid())
  auditId   String
  playerId  String
  role      AuditRoleAssignmentRole
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  audit     Audit                   @relation(fields: [auditId], references: [id], onDelete: Restrict)
  player    Player                  @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([auditId, playerId, role])
  @@index([auditId])
  @@index([playerId])
}

model EventCommandGroup {
  id                   String             @id @default(cuid())
  eventId              String
  eventParticipationId String?
  name                 String
  side                 BattlefieldSide?
  commanderPlayerId    String
  parentGroupId        String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  event                Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  eventParticipation   EventParticipation? @relation(fields: [eventParticipationId], references: [id], onDelete: Restrict)
  commanderPlayer   Player              @relation("EventGroupCommander", fields: [commanderPlayerId], references: [id], onDelete: Restrict)
  parentGroup       EventCommandGroup?  @relation("EventCommandGroupTree", fields: [parentGroupId], references: [id], onDelete: Restrict)
  childGroups       EventCommandGroup[] @relation("EventCommandGroupTree")
  atomicUnitMemberships EventCommandGroupAtomicUnit[]

  @@index([eventId, parentGroupId])
  @@index([eventParticipationId])
  @@index([commanderPlayerId])
}

model EventResult {
  id                String            @id @default(cuid())
  eventId           String
  value             EventResultValue
  status            EventResultStatus
  proposedByUserId  String
  reviewedByUserId  String?
  reviewedAt        DateTime?
  supersedesId      String?
  createdAt         DateTime          @default(now())
  event             Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  proposedBy        User              @relation("EventResultProposer", fields: [proposedByUserId], references: [id], onDelete: Restrict)
  reviewedBy        User?             @relation("EventResultReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  supersedes        EventResult?      @relation("EventResultSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy     EventResult[]      @relation("EventResultSupersession")

  @@index([eventId, status])
  @@index([proposedByUserId])
  @@index([reviewedByUserId])
  @@index([supersedesId])
}

model EventCommandGroupAtomicUnit {
  groupId           String
  atomicEventUnitId String   @unique
  createdAt         DateTime @default(now())
  group             EventCommandGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  atomicEventUnit   AtomicEventUnit   @relation(fields: [atomicEventUnitId], references: [id], onDelete: Restrict)

  @@id([groupId, atomicEventUnitId])
  @@index([groupId])
}

model UnitMembership {
  id        String    @id @default(cuid())
  playerId  String
  unitId    String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Restrict)
  unit      Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)

  // Active pair uniqueness is enforced by a partial index in the SQL migration.
  @@index([playerId, startedAt])
  @@index([unitId, endedAt])
}

model RootUnit {
  unitId          String   @id
  designatedUnit  Unit     @relation("RootDesignation", fields: [unitId], references: [id], onDelete: Restrict)
  units           Unit[]   @relation("UnitRoot")
  ranks           RankDefinition[]
  medals          MedalDefinition[]
}

model AuthorizedUserMembership {
  id              String          @id @default(cuid())
  userId          String
  unitId          String
  authorityLevel  Int
  endedAt         DateTime?
  createdByUserId String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation("MembershipUser", fields: [userId], references: [id], onDelete: Restrict)
  unit            Unit            @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdBy       User            @relation("MembershipCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  grants          PermissionGrant[]

  @@index([userId])
  @@index([userId, endedAt])
  @@index([unitId])
  @@index([unitId, endedAt])
  @@index([unitId, authorityLevel])
}

model RankDefinition {
  id          String   @id @default(cuid())
  rootUnitId  String
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rootUnit    RootUnit @relation(fields: [rootUnitId], references: [unitId], onDelete: Restrict)

  @@unique([rootUnitId, name])
  @@index([rootUnitId, sortOrder, name])
}

model MedalDefinition {
  id          String   @id @default(cuid())
  rootUnitId  String
  name        String
  description String?
  imageRef    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rootUnit    RootUnit @relation(fields: [rootUnitId], references: [unitId], onDelete: Restrict)

  @@unique([rootUnitId, name])
  @@index([rootUnitId])
}

enum Permission {
  MANAGE_UNIT
  MANAGE_STRUCTURE
  MANAGE_ROSTER
  REQUEST_EVENT_PARTICIPATION
  MANAGE_EVENTS
  SUBMIT_AUDITS
  MANAGE_AUTHORIZED_USERS
}

enum PermissionScope {
  SELF
  SELF_AND_CHILDREN
  SELF_AND_DESCENDANTS
}

model PermissionGrant {
  id                         String                   @id @default(cuid())
  authorizedUserMembershipId String
  permission                 Permission
  scope                      PermissionScope?
  delegatedFromGrantId       String?
  createdByUserId            String
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  revokedAt                  DateTime?
  revokedByUserId            String?
  membership                 AuthorizedUserMembership @relation(fields: [authorizedUserMembershipId], references: [id], onDelete: Restrict)
  delegatedFromGrant         PermissionGrant?        @relation("GrantDelegation", fields: [delegatedFromGrantId], references: [id], onDelete: Restrict)
  delegatedGrants            PermissionGrant[]       @relation("GrantDelegation")
  createdBy                  User                     @relation("GrantCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedBy                  User?                    @relation("GrantRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@index([authorizedUserMembershipId])
  @@index([delegatedFromGrantId])
  @@index([createdByUserId])
  @@index([revokedByUserId])
}
