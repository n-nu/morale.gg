# Local-only development values. Copy this file to .env and override as needed.
# The local PostgreSQL password is disposable and should never be used in production.
POSTGRES_DB="morale_gg"
POSTGRES_USER="morale_gg"
POSTGRES_PASSWORD="local-dev-password"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://morale_gg:local-dev-password@localhost:5432/morale_gg?schema=public"
AUTH_SECRET="replace-with-a-random-development-secret"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
ROOT_UNIT_NAME="morale.gg Root Unit"